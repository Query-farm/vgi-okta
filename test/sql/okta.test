# ---------------------------------------------------------------- network zones

# The first zones request answers 503; it is retried.
query TTTT
SELECT name, type, usage, gateways FROM okta.main.network_zones ORDER BY name;
----
Allowed countries	DYNAMIC	POLICY	NULL
Blocked IPs	IP	BLOCKLIST	[203.0.113.0/24, 198.51.100.7-198.51.100.9]
LegacyIpZone	IP	POLICY	[10.0.0.0/8]

query TTT
SELECT locations, asns, proxy_type FROM okta.main.network_zones WHERE usage = 'POLICY' AND type = 'DYNAMIC';
----
[US, CA-ON]	[13335]	NOT_TOR

query T
SELECT query::JSON->>'filter' FROM read_json('{OKTA_FIXTURE_URL}/__requests?path=/api/v1/zones') ORDER BY seq DESC LIMIT 1;
----
usage eq "POLICY"

# ------------------------------------------------------------------- system log

# Default window: the last 7 days (events 1-6 and 10 of the fixture), bounded by
# `until`, so Okta's never-ending ASCENDING poll link does not apply.
query I
SELECT count(*) FROM okta.main.system_log();
----
7

query TT
SELECT (query::JSON->>'until') IS NOT NULL, query::JSON->>'sortOrder' FROM read_json('{OKTA_FIXTURE_URL}/__requests?path=/api/v1/logs') ORDER BY seq DESC LIMIT 1;
----
true	ASCENDING

# A lower bound on published becomes `since`; past the 90-day retention it is clamped
# (Okta would answer 400), so the 100-day-old event is never requested.
query I
SELECT count(*) FROM okta.main.system_log() WHERE published > (now()::TIMESTAMP - INTERVAL 120 DAY)::TIMESTAMPTZ;
----
9

query I
SELECT count(*) FROM okta.main.system_log(lookback_days := 31) WHERE created_date_time < (now()::TIMESTAMP - INTERVAL 1 DAY)::TIMESTAMPTZ;
----
3

query TTT
SELECT actor_alternate_id, outcome_reason, count(*) FROM okta.main.system_log() WHERE event_type = 'user.session.start' AND outcome_result = 'FAILURE' GROUP BY ALL ORDER BY ALL;
----
alan@example.com	INVALID_CREDENTIALS	2
grace@example.com	VERIFICATION_ERROR	1

query T
SELECT query::JSON->>'filter' FROM read_json('{OKTA_FIXTURE_URL}/__requests?path=/api/v1/logs') ORDER BY seq DESC LIMIT 1;
----
eventType eq "user.session.start" and outcome.result eq "FAILURE"

query T
SELECT event_type FROM okta.main.system_log(page_size := 2) WHERE starts_with(event_type, 'user.authentication.') ORDER BY published;
----
user.authentication.auth_via_mfa
user.authentication.sso

query TTT
SELECT user_principal_name, app_display_name, targets[1].type FROM okta.main.system_log() WHERE event_type = 'user.authentication.sso';
----
ada@example.com	Salesforce	AppInstance

query I
SELECT count(*) FROM okta.main.system_log(q := 'INVALID_CREDENTIALS');
----
2

query T
SELECT event_type FROM okta.main.system_log(sort_order := 'DESCENDING') LIMIT 1;
----
user.authentication.sso

query TT
SELECT severity, ip_address FROM okta.main.system_log() WHERE actor_id = '00u3alan' AND severity = 'WARN';
----
WARN	203.0.113.9

query TTT
SELECT typeof(published), typeof(geo_lat), typeof(debug_data) FROM okta.main.system_log() LIMIT 1;
----
TIMESTAMP WITH TIME ZONE	DOUBLE	JSON

# An empty window issues no request at all.
query I
SELECT count(*) FROM okta.main.system_log() WHERE published < (now()::TIMESTAMP - INTERVAL 200 DAY)::TIMESTAMPTZ;
----
0

statement error
SELECT * FROM okta.main.system_log(sort_order := 'SIDEWAYS');
----
<REGEX>:.*

statement error
SELECT * FROM okta.main.system_log(lookback_days := 91);
----
<REGEX>:.*

# Entra-aligned columns UNION with an Entra-shaped relation.
query TT
SELECT source, count(*) FROM (
  SELECT 'okta' AS source, user_principal_name, display_name, account_enabled FROM okta.main.users()
  UNION ALL
  SELECT 'entra', 'x@contoso.com', 'X', true
) GROUP BY source ORDER BY source;
----
entra	1
okta	6

statement ok
DROP SECRET okta_fixture;

# ------------------------------------------- OAuth 2.0 service app (private_key_jwt)

# EC P-256 key (ES256), PEM with literal \n escapes; the replay server verifies the
# signed client assertion and enforces the granted scopes.
statement ok
CREATE SECRET okta_service (TYPE okta, ORG_URL '{OKTA_FIXTURE_URL}', CLIENT_ID '0oaserviceappec', KEY_ID 'kid-ec', SCOPES 'okta.users.read okta.groups.read', PRIVATE_KEY '-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg8/2jmKU/sbRa8KGd\n45l8qdwBce/MILRUwiX+EspV3B6hRANCAARvBEGvc/RlU+7jA03ZHJi2UhSOj9M2\nb//bBdMSieu4xU+n2tHSq4A9PIkdkjUFF1e5Z1s2rJtT2Gpqt4dHfBqV\n-----END PRIVATE KEY-----\n');

query I
SELECT count(*) FROM okta.main.users(page_size := 4);
----
6

query T
SELECT DISTINCT auth FROM read_json('{OKTA_FIXTURE_URL}/__requests?path=/api/v1/users') WHERE seq > (SELECT max(seq) FROM read_json('{OKTA_FIXTURE_URL}/__requests?path=/oauth2/v1/token'));
----
bearer

query T
SELECT query::JSON->>'scope' FROM read_json('{OKTA_FIXTURE_URL}/__requests?path=/oauth2/v1/token') ORDER BY seq DESC LIMIT 1;
----
okta.users.read okta.groups.read

# The token was not granted okta.logs.read: Okta answers 403.
statement error
SELECT count(*) FROM okta.main.system_log();
----
<REGEX>:.*HTTP 403.*

statement ok
DROP SECRET okta_service;

# An unknown service app is rejected at the token endpoint.
statement ok
CREATE SECRET okta_unknown (TYPE okta, ORG_URL '{OKTA_FIXTURE_URL}', CLIENT_ID '0oanotregistered', PRIVATE_KEY '-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg8/2jmKU/sbRa8KGd\n45l8qdwBce/MILRUwiX+EspV3B6hRANCAARvBEGvc/RlU+7jA03ZHJi2UhSOj9M2\nb//bBdMSieu4xU+n2tHSq4A9PIkdkjUFF1e5Z1s2rJtT2Gpqt4dHfBqV\n-----END PRIVATE KEY-----\n');

statement error
SELECT count(*) FROM okta.main.groups();
----
<REGEX>:.*token request failed with HTTP 401.*

statement ok
DROP SECRET okta_unknown;
